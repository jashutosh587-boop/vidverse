# Installed by deploy/install.sh as /etc/systemd/system/vidverse-web.service.
# The installer replaces @NODE@ with the full path of the Node.js program it found.
#
# If you move DATA_DIR in /etc/vidverse/vidverse.env, change ReadWritePaths to match: this service cannot write
# anywhere else on the disk.
[Unit]
Description=Vidverse website
After=network-online.target postgresql.service
Wants=network-online.target postgresql.service

[Service]
Type=simple
User=vidverse
Group=vidverse
WorkingDirectory=/opt/vidverse/current
Environment=ENV_FILE=/etc/vidverse/vidverse.env
ExecStart=@NODE@ src/server.js
SyslogIdentifier=vidverse-web
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
LimitNOFILE=65536
UMask=0077

# The site runs as an ordinary user that can write only its own data folder.
NoNewPrivileges=yes
CapabilityBoundingSet=
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/vidverse
ProtectHome=yes
ProtectHostname=yes
ProtectClock=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
RestrictNamespaces=yes
LockPersonality=yes
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
