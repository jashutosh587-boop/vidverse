# Copy to .env and fill in. Nothing here is a secret until you put one in; never commit .env.
# The site refuses to start in production when a required value is missing or still a development value.
#
# Variables left empty or deleted fall back to the defaults in src/config.js.

# ---------------------------------------------------------------- basics
NODE_ENV=production
# The public address people type, with https. No path. Used in emails, links and the sitemap.
BASE_URL=https://example.com
SITE_NAME=Vidverse
PORT=3000
# Which network address the site listens on. Left out, production listens on all of them (right for Docker and most
# hosting services). With Caddy or nginx on the same server, 127.0.0.1 means only that proxy can reach the site.
# HOST=127.0.0.1
# Behind one reverse proxy (Caddy, nginx, a load balancer) this is 1. Leave 0 only when nothing sits in front.
TRUST_PROXY=1
# debug | info | warn | error | silent
LOG_LEVEL=info
# Uploaded and processed video files live here. Back this folder up.
DATA_DIR=/var/lib/vidverse

# ---------------------------------------------------------------- secrets (generate your own)
# At least 32 random characters:   openssl rand -base64 48
SESSION_SECRET=
# One or more "name:base64key" pairs, comma separated; the FIRST encrypts new data, the others only decrypt.
# To rotate: add a new first entry and keep the old one until everything has been re-saved.
#   node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEYS=

# ---------------------------------------------------------------- database
# Required in production (Postgres 15 or newer). Without it the embedded development database is used.
DATABASE_URL=postgres://vidverse:change-me@localhost:5432/vidverse
# Set to false only for a database on the same private network that does not offer TLS.
DATABASE_SSL=true

# ---------------------------------------------------------------- email (sign-up confirmation, password reset)
# Required in production. Any SMTP provider works.
SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=Vidverse <no-reply@example.com>

# ---------------------------------------------------------------- background work
# inprocess = the website also processes videos | separate = run `npm run worker` yourself | off
WORKER=inprocess
# standard = several sizes up to 1080p | fast = fewer, smaller sizes (quicker, cheaper)
TRANSCODE_PROFILE=standard
MAX_UPLOAD_BYTES=2147483648
MAX_VIDEO_SECONDS=10800
DAILY_UPLOAD_LIMIT=20
CREATOR_STORAGE_QUOTA_BYTES=21474836480

# ---------------------------------------------------------------- Google AdSense (your earnings as the site owner)
# Leave empty until Google has approved your site. Then ads appear only on watch pages, and only for videos that are
# eligible. See docs/MONETIZATION.md.
ADSENSE_CLIENT=
ADSENSE_SLOT_WATCH_TOP=
ADSENSE_SLOT_WATCH_SIDE=
# The line AdSense gives you for /ads.txt, e.g.  google.com, pub-1234567890123456, DIRECT, f08c47fec0942fa0
ADS_TXT=
# true = ask Google for non-personalised ads only (the default).
ADS_NON_PERSONALIZED=true
# Personalised ads (ADS_NON_PERSONALIZED=false) are used only if you ALSO set this to true. Set it only after you have
# switched on a Google-certified consent message for visitors in the EEA, UK and Switzerland (in AdSense: Privacy &
# messaging). This site has no consent banner of its own, and it never claims one.
ADS_CONSENT_CONFIRMED=false
ADS_DEFAULT_ELIGIBLE=true

# ---------------------------------------------------------------- tips and payouts
# razorpay | off.  ("test" exists for trying the screens on your own computer and is refused in production.)
PAYMENTS_PROVIDER=off
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# The secret you type into Razorpay's dashboard when you add the webhook https://example.com/webhooks/razorpay
RAZORPAY_WEBHOOK_SECRET=
# Platform fee in basis points (1000 = 10%), the smallest and largest tip and the smallest payout, in paise.
PLATFORM_FEE_BPS=1000
TIP_MIN_MINOR=2000
TIP_MAX_MINOR=5000000
PAYOUT_MIN_MINOR=50000
# Days a tip is held before the creator can withdraw it (time for refunds and disputes).
HOLD_DAYS=7

# ---------------------------------------------------------------- help assistant (optional)
# Without a key the assistant still answers, by quoting the best-matching help article.
ANTHROPIC_API_KEY=
ASSISTANT_MODEL=claude-haiku-5-5
# Hard stop on model calls per day (counted per process), so a flood of questions cannot become a surprise bill.
ASSISTANT_DAILY_LIMIT=2000

# ---------------------------------------------------------------- who you are (shown on the legal pages)
# All of these are required in production. The legal pages are TEMPLATES: have a lawyer review them, then set
# LEGAL_REVIEWED=true. To launch before that, set ALLOW_UNREVIEWED_LEGAL=true and the pages show a "draft" notice.
OPERATOR_NAME=
OPERATOR_ADDRESS=
CONTACT_EMAIL=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
LEGAL_JURISDICTION=
LEGAL_REVIEWED=false
ALLOW_UNREVIEWED_LEGAL=false

# ---------------------------------------------------------------- limits
# The built-in rate limiter works inside one process. With several copies, also limit at the proxy.
RATE_LIMITS=true
